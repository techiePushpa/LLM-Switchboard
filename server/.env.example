# Copy this file to .env and fill in your own values.

# Your Postgres connection string (Neon, local, or any Postgres host):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/chatforge?schema=public"

# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-long-random-string"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# --- Deploying publicly? ---
# CLIENT_ORIGIN: your deployed frontend's exact URL (e.g. https://your-app.vercel.app)
#   -- no trailing slash. This must match exactly or CORS silently blocks every request.
# NODE_ENV: set to "production". This switches the login cookie to Secure + SameSite=None,
#   which is required once the frontend and backend are on different domains -- without
#   this, login will appear to work but the session won't persist.

# --- AI provider API keys ---
# All three are genuinely free, no card required. The model routing in
# server/src/config/models.ts decides which key gets used for which
# model -- you need all three filled in for every model in that list to
# work, or just remove entries for providers you don't want to use.

# console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY="replace-with-your-groq-key"

# openrouter.ai -> Keys -> Create Key
OPENROUTER_API_KEY="replace-with-your-openrouter-key"

# huggingface.co -> Settings -> Access Tokens -> Create new token (read access is enough)
HF_API_KEY="replace-with-your-huggingface-token"
