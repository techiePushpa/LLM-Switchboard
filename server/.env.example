# Copy this file to .env and fill in your own values.

# Your local Postgres connection string. Example if you installed Postgres
# with the default superuser and created a database called "chatforge":
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/chatforge?schema=public"

# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-long-random-string"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Where your local Ollama server is listening. Default is correct for a
# standard install -- change only if you've moved it.
OLLAMA_BASE_URL="http://localhost:11434"
